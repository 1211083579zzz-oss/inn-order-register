<view class="page">
  <view class="content">
    <view class="topbar"><text class="date-label">{{todayLabel}}</text><button class="backup-button" bindtap="onBackupMenu"><image class="icon" src="/assets/icons/backup-blue.svg" />备份</button></view>
    <view class="page-heading"><view class="page-title">入住记录</view><view class="local-badge"><image class="small-icon" src="/assets/icons/lock-muted.svg" />本机保存</view></view>
    <button class="add-button" bindtap="onAddOrder"><image class="icon" src="/assets/icons/plus-white.svg" /><text>新增入住登记</text><image class="button-arrow" src="/assets/icons/chevron-white.svg" /></button>
    <view class="search-box"><image class="search-icon" src="/assets/icons/search-muted.svg" /><input class="search-input" value="{{query}}" bindinput="onSearch" placeholder="搜索姓名、电话或订单" confirm-type="search" /><button wx:if="{{query}}" class="search-clear" bindtap="onClearSearch"><image class="small-icon" src="/assets/icons/close-muted.svg" /></button></view>
    <view class="filters"><button wx:for="{{filters}}" wx:key="key" class="filter {{activeFilter === item.key ? 'filter-active' : ''}}" data-filter="{{item.key}}" bindtap="onFilter">{{item.label}}</button></view>
    <view class="list-heading"><text class="list-title">{{filterTitle}}</text><text class="list-count">{{orderCount}} 条记录</text></view>
    <view wx:if="{{orders.length}}" class="order-list">
      <view wx:for="{{orders}}" wx:key="id" class="order-card" data-id="{{item.id}}" bindtap="onOpenOrder">
        <view class="record-heading"><text class="hotel-order">{{item.hotelOrder || '未填写订单名称'}}</text><text class="status status-{{item.statusKey}}">{{item.statusLabel}}</text></view>
        <view class="base-line"><image class="small-icon" src="/assets/icons/pin-muted.svg" /><text>{{item.base || '未填写基地'}}</text></view>
        <view class="stay-line"><text class="stay-date">{{item.dateDisplay}}</text><text class="stay-caption">入住</text><text class="night-tag">{{item.nights}} 晚</text></view>
        <view class="guest-row"><text class="guest-name">{{item.customerName || '未填写姓名'}}</text><button wx:if="{{item.phone}}" class="phone-link" catchtap="onCallCustomer" data-phone="{{item.phone}}"><image class="small-icon" src="/assets/icons/phone-blue.svg" />{{item.phone}}</button></view>
        <view class="stay-details"><view><image class="small-icon" src="/assets/icons/users-muted.svg" />{{item.guestCount}}</view><view><image class="small-icon" src="/assets/icons/bed-muted.svg" />{{item.roomType}}</view><view><image class="small-icon" src="/assets/icons/meal-muted.svg" />{{item.mealIncluded === '是' ? '含餐' : '不含餐'}}</view></view>
        <view class="record-footer"><view class="fee-line"><block wx:if="{{item.feeDetails}}"><view class="fee-label">费用明细</view><text class="fee-value">{{item.feeDetails}}</text></block><text wx:else class="fee-empty">未填写费用明细</text></view><view class="record-open"><image class="icon" src="/assets/icons/chevron-blue.svg" /></view></view>
      </view>
    </view>
    <view wx:else class="empty-state"><view class="empty-icon"><image src="/assets/icons/book-blue.svg" /></view><view class="empty-title">{{hasData ? '暂无符合条件的登记' : '从第一条登记开始'}}</view><view class="empty-caption">{{hasData ? '试试其他关键词或切换到全部记录' : '点击上方「新增入住登记」，记下本次入住安排。'}}</view><button wx:if="{{hasData}}" class="empty-reset" bindtap="onResetFilter">查看全部登记</button></view>
    <view class="device-note"><image class="small-icon" src="/assets/icons/lock-muted.svg" />登记信息仅保存在当前设备</view>
  </view>
</view>
