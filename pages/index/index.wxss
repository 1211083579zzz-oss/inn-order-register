.page { min-height: 100vh; background: #f4f6fa; color: #17233c; }
.content { padding: 18rpx 38rpx 40rpx; }
.icon { width: 40rpx; height: 40rpx; flex: none; }
.small-icon { width: 27rpx; height: 27rpx; flex: none; }
.topbar { display: flex; align-items: center; justify-content: space-between; gap: 20rpx; }
.date-label { color: #59667d; font-size: 25rpx; }
.backup-button { display: flex; min-height: 84rpx; align-items: center; gap: 10rpx; padding: 0; color: #1260de; background: transparent; font-size: 27rpx; }
.backup-button .icon { width: 34rpx; height: 34rpx; }
.page-heading { display: flex; align-items: center; justify-content: space-between; gap: 20rpx; margin: 0 0 40rpx; }
.page-title { color: #17233c; font-size: 56rpx; font-weight: 700; line-height: 1.3; }
.local-badge { display: flex; align-items: center; gap: 7rpx; color: #59667d; font-size: 23rpx; }
.add-button { display: flex; width: 100%; height: 112rpx; align-items: center; gap: 20rpx; padding: 0 29rpx; border-radius: 23rpx; color: #fff; background: #1260de; font-size: 31rpx; font-weight: 600; line-height: 1; }
.button-arrow { width: 30rpx; height: 30rpx; margin-left: auto; }
.search-box { display: flex; height: 94rpx; align-items: center; gap: 16rpx; margin-top: 38rpx; padding: 0 24rpx; border-radius: 19rpx; background: #e9edf4; }
.search-icon { width: 33rpx; height: 33rpx; flex: none; }
.search-input { min-width: 0; height: 84rpx; flex: 1; color: #17233c; font-size: 29rpx; }
.search-input::placeholder { color: #59667d; }
.search-clear { display: flex; width: 58rpx; height: 84rpx; align-items: center; justify-content: center; padding: 0; background: transparent; }
.filters { display: flex; gap: 7rpx; margin-top: 32rpx; padding: 7rpx; border-radius: 20rpx; background: #e9edf4; }
.filter { min-width: 0; height: 78rpx; flex: 1; margin: 0; padding: 0 4rpx; border-radius: 15rpx; color: #59667d; background: transparent; font-size: 27rpx; line-height: 78rpx; }
.filter-active { color: #1260de; background: #fff; box-shadow: 0 2rpx 5rpx #24304c14; font-weight: 600; }
.list-heading { display: flex; align-items: center; justify-content: space-between; margin: 40rpx 3rpx 22rpx; }
.list-title { font-size: 29rpx; font-weight: 600; }
.list-count { color: #59667d; font-size: 23rpx; }
.order-list { display: flex; flex-direction: column; gap: 24rpx; }
.order-card { min-width: 0; padding: 30rpx; border: 1rpx solid #e5eaf2; border-radius: 28rpx; background: #fff; }
.record-heading { display: flex; align-items: flex-start; justify-content: space-between; gap: 18rpx; }
.hotel-order { min-width: 0; font-size: 31rpx; font-weight: 600; line-height: 1.5; word-break: break-all; }
.status { flex: none; padding: 4rpx 13rpx; border-radius: 8rpx; color: #4e5c73; background: #eff2f6; font-size: 21rpx; line-height: 1.8; }
.status-upcoming { color: #1255bb; background: #edf4ff; }
.status-staying { color: #176347; background: #eaf5ee; }
.base-line { display: flex; align-items: center; gap: 8rpx; margin-top: 9rpx; color: #59667d; font-size: 25rpx; }
.stay-line { display: flex; align-items: center; gap: 12rpx; margin-top: 34rpx; }
.stay-date { font-size: 37rpx; font-weight: 600; }
.stay-caption { color: #59667d; font-size: 23rpx; }
.night-tag { margin-left: auto; padding: 5rpx 16rpx; border-radius: 10rpx; color: #1260de; background: #eaf2ff; font-size: 25rpx; }
.guest-row { display: flex; align-items: center; justify-content: space-between; gap: 14rpx; margin-top: 15rpx; }
.guest-name { min-width: 0; font-size: 29rpx; font-weight: 550; }
.phone-link { display: flex; min-height: 84rpx; align-items: center; gap: 9rpx; margin: 0; padding: 0; color: #1260de; background: transparent; font-size: 24rpx; line-height: 1.5; }
.stay-details { display: flex; flex-wrap: wrap; gap: 12rpx 26rpx; padding-bottom: 26rpx; color: #59667d; font-size: 23rpx; }
.stay-details > view { display: flex; min-width: 0; align-items: center; gap: 7rpx; word-break: break-all; }
.record-footer { display: flex; align-items: center; gap: 15rpx; padding-top: 22rpx; border-top: 1rpx solid #e5eaf2; }
.fee-line { min-width: 0; flex: 1; font-size: 23rpx; }
.fee-label { margin-bottom: 4rpx; color: #59667d; font-size: 21rpx; }
.fee-value { line-height: 1.7; word-break: break-all; white-space: pre-wrap; }
.fee-empty { color: #59667d; }
.record-open { display: flex; width: 84rpx; height: 84rpx; flex: none; align-items: center; justify-content: center; border-radius: 50%; background: #f2f6fe; }
.record-open .icon { width: 32rpx; height: 32rpx; }
.empty-state { display: flex; min-height: 460rpx; flex-direction: column; align-items: center; justify-content: center; padding: 48rpx 24rpx; text-align: center; }
.empty-icon { display: flex; width: 120rpx; height: 120rpx; align-items: center; justify-content: center; margin-bottom: 30rpx; border-radius: 28rpx; background: #e7effe; }
.empty-icon image { width: 58rpx; height: 58rpx; }
.empty-title { margin-bottom: 12rpx; font-size: 32rpx; font-weight: 600; }
.empty-caption { max-width: 450rpx; color: #59667d; font-size: 25rpx; line-height: 1.8; }
.empty-reset { min-height: 84rpx; margin-top: 20rpx; padding: 0 24rpx; border-radius: 14rpx; color: #1260de; background: #eaf2ff; font-size: 25rpx; }
.device-note { display: flex; align-items: center; justify-content: center; gap: 8rpx; margin-top: 46rpx; color: #59667d; font-size: 21rpx; }
.device-note .small-icon { width: 24rpx; height: 24rpx; }

.filter, .backup-button, .search-clear, .phone-link, .empty-reset { min-height: 44px; }
