.page {
  min-height: 100vh;
  padding-bottom: 142rpx;
  background: #f4f5f2;
}

.topbar {
  display: flex;
  align-items: center;
  padding: 32rpx 30rpx 25rpx;
  border-bottom: 1rpx solid #e8ebe8;
  background: #ffffff;
}

.brand-mark {
  display: flex;
  width: 74rpx;
  height: 74rpx;
  flex: none;
  align-items: center;
  justify-content: center;
  border-radius: 18rpx;
  color: #ffffff;
  background: #176f68;
  font-size: 34rpx;
  font-weight: 700;
}

.brand-copy {
  min-width: 0;
  flex: 1;
  margin-left: 17rpx;
}

.top-title {
  color: #202b29;
  font-size: 32rpx;
  font-weight: 700;
  line-height: 1.25;
}

.top-subtitle {
  margin-top: 8rpx;
  color: #7d8984;
  font-size: 21rpx;
}

.subtitle-dot {
  margin: 0 7rpx;
  color: #d48248;
}

.backup-button {
  min-width: 86rpx;
  height: 58rpx;
  flex: none;
  margin-left: 13rpx;
  padding: 0 16rpx;
  border: 1rpx solid #dce4e0;
  border-radius: 10rpx;
  color: #4b5a55;
  background: #ffffff;
  font-size: 22rpx;
  line-height: 58rpx;
}

.content {
  padding: 23rpx 26rpx 24rpx;
}

.search-box {
  display: flex;
  height: 78rpx;
  align-items: center;
  padding: 0 20rpx;
  border: 1rpx solid #e0e6e2;
  border-radius: 12rpx;
  background: #ffffff;
}

.search-icon {
  position: relative;
  width: 27rpx;
  height: 27rpx;
  flex: none;
  margin-right: 14rpx;
}

.search-icon::before {
  position: absolute;
  top: 1rpx;
  left: 1rpx;
  width: 16rpx;
  height: 16rpx;
  border: 3rpx solid #7c8984;
  border-radius: 50%;
  content: "";
}

.search-icon::after {
  position: absolute;
  right: 0;
  bottom: 1rpx;
  width: 10rpx;
  height: 3rpx;
  border-radius: 2rpx;
  background: #7c8984;
  content: "";
  transform: rotate(45deg);
}

.search-input {
  min-width: 0;
  flex: 1;
  color: #24312e;
  font-size: 24rpx;
}

.search-clear {
  padding-left: 14rpx;
  color: #176f68;
  font-size: 21rpx;
}

.list-heading {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin: 29rpx 0 14rpx;
}

.list-title {
  color: #25322f;
  font-size: 29rpx;
  font-weight: 700;
}

.list-count {
  color: #8a9591;
  font-size: 20rpx;
}

.order-list {
  display: flex;
  flex-direction: column;
  gap: 15rpx;
}

.order-card {
  padding: 22rpx 21rpx 17rpx;
  border: 1rpx solid #e5e9e6;
  border-radius: 13rpx;
  background: #ffffff;
  box-shadow: 0 4rpx 14rpx rgba(33, 55, 48, 0.035);
}

.hotel-order {
  overflow: hidden;
  color: #202b29;
  font-size: 28rpx;
  font-weight: 700;
  line-height: 1.35;
  text-overflow: ellipsis;
}

.base-line {
  display: flex;
  align-items: center;
  gap: 9rpx;
  margin-top: 12rpx;
  color: #6e7c76;
  font-size: 21rpx;
}

.base-mark {
  width: 10rpx;
  height: 10rpx;
  flex: none;
  border-radius: 50%;
  background: #d48248;
}

.guest-row,
.card-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 10rpx;
}

.guest-row {
  justify-content: flex-start;
  gap: 12rpx;
  margin-top: 19rpx;
}

.guest-name {
  color: #2a3733;
  font-size: 26rpx;
  font-weight: 600;
}

.phone-link {
  padding: 5rpx 11rpx;
  border-radius: 7rpx;
  color: #176f68;
  background: #edf5f2;
  font-size: 19rpx;
  line-height: 1.4;
}

.detail-grid {
  display: grid;
  grid-template-columns: 1.2fr 1fr;
  gap: 13rpx 10rpx;
  margin-top: 19rpx;
  padding: 17rpx 15rpx;
  border-radius: 9rpx;
  background: #f6f7f5;
}

.detail-item {
  display: flex;
  min-width: 0;
  flex-direction: column;
  gap: 6rpx;
}

.detail-key {
  color: #89938f;
  font-size: 19rpx;
}

.detail-value {
  overflow: hidden;
  color: #34413d;
  font-size: 22rpx;
  font-weight: 550;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.meal-value {
  color: #a86631;
}

.fee-line {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
  margin-top: 15rpx;
  padding: 12rpx 13rpx;
  border-left: 4rpx solid #d48248;
  border-radius: 0 7rpx 7rpx 0;
  background: #fbf6ef;
}

.fee-label {
  flex: none;
  color: #95663c;
  font-size: 20rpx;
}

.fee-value {
  min-width: 0;
  color: #574b40;
  font-size: 21rpx;
  line-height: 1.45;
  word-break: break-word;
}

.card-footer {
  margin-top: 14rpx;
  padding-top: 12rpx;
  border-top: 1rpx solid #edf0ee;
  color: #88938e;
  font-size: 19rpx;
}

.edit-label {
  flex: none;
  color: #52635d;
}

.chevron {
  margin-left: 4rpx;
  color: #86918c;
  font-size: 27rpx;
}

.empty-state {
  display: flex;
  min-height: 330rpx;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border: 1rpx dashed #d6ded9;
  border-radius: 13rpx;
  background: rgba(255, 255, 255, 0.72);
}

.empty-symbol {
  display: flex;
  width: 70rpx;
  height: 70rpx;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  color: #176f68;
  background: #e3f1ec;
  font-size: 42rpx;
}

.empty-title {
  margin-top: 17rpx;
  color: #34423d;
  font-size: 26rpx;
  font-weight: 600;
}

.empty-caption {
  margin-top: 8rpx;
  color: #8a9591;
  font-size: 21rpx;
}

.bottom-bar {
  position: fixed;
  z-index: 3;
  right: 0;
  bottom: 0;
  left: 0;
  padding: 16rpx 26rpx calc(16rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid #e4e9e6;
  background: rgba(255, 255, 255, 0.98);
}

.add-button {
  display: flex;
  width: 100%;
  height: 84rpx;
  align-items: center;
  justify-content: center;
  border-radius: 11rpx;
  color: #ffffff;
  background: #243c38;
  font-size: 27rpx;
  font-weight: 600;
  line-height: 84rpx;
}

.add-mark {
  margin-right: 10rpx;
  font-size: 34rpx;
  font-weight: 400;
}
