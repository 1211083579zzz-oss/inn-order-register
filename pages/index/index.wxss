.page {
  min-height: 100vh;
  padding-bottom: 150rpx;
}

.hero {
  padding: 42rpx 34rpx 30rpx;
  color: #ffffff;
  background: #176f68;
}

.hero-top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
}

.eyebrow {
  color: #b8ddd6;
  font-size: 19rpx;
  font-weight: 600;
  line-height: 1.2;
}

.hero-title {
  margin-top: 12rpx;
  font-size: 42rpx;
  font-weight: 700;
  line-height: 1.25;
}

.hero-date {
  margin-top: 9rpx;
  color: #d3e8e3;
  font-size: 23rpx;
}

.backup-button {
  display: flex;
  align-items: center;
  gap: 9rpx;
  min-height: 64rpx;
  padding: 0 20rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.42);
  border-radius: 12rpx;
  color: #ffffff;
  background: rgba(255, 255, 255, 0.1);
  font-size: 24rpx;
  line-height: 64rpx;
}

.stats {
  display: grid;
  grid-template-columns: 1fr 1.2fr 1fr;
  margin-top: 36rpx;
  padding: 22rpx 0 5rpx;
  border-top: 1rpx solid rgba(255, 255, 255, 0.2);
}

.stat-cell {
  display: flex;
  min-width: 0;
  flex-direction: column;
  gap: 10rpx;
}

.stat-middle {
  padding-left: 22rpx;
  border-left: 1rpx solid rgba(255, 255, 255, 0.2);
  border-right: 1rpx solid rgba(255, 255, 255, 0.2);
}

.stat-cell:last-child {
  padding-left: 22rpx;
}

.stat-label {
  color: #c4e1dc;
  font-size: 21rpx;
}

.stat-value {
  overflow: hidden;
  font-size: 31rpx;
  font-weight: 700;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.stat-unit {
  margin-left: 5rpx;
  font-size: 21rpx;
  font-weight: 400;
}

.content {
  padding: 24rpx 28rpx 20rpx;
}

.search-box {
  display: flex;
  height: 82rpx;
  align-items: center;
  padding: 0 20rpx;
  border: 1rpx solid #e1e7e4;
  border-radius: 12rpx;
  background: #ffffff;
}

.search-icon {
  position: relative;
  width: 27rpx;
  height: 27rpx;
  margin-right: 13rpx;
  color: #73817d;
}

.search-icon::before {
  position: absolute;
  top: 1rpx;
  left: 1rpx;
  width: 16rpx;
  height: 16rpx;
  border: 3rpx solid #73817d;
  border-radius: 50%;
  content: "";
}

.search-icon::after {
  position: absolute;
  right: 0;
  bottom: 1rpx;
  width: 10rpx;
  height: 3rpx;
  border-radius: 2rpx;
  background: #73817d;
  content: "";
  transform: rotate(45deg);
}

.search-input {
  flex: 1;
  min-width: 0;
  color: #1d2928;
  font-size: 25rpx;
}

.search-clear {
  padding-left: 14rpx;
  color: #176f68;
  font-size: 22rpx;
}

.filter-scroll {
  margin: 22rpx -28rpx 25rpx;
  white-space: nowrap;
}

.filters {
  display: inline-flex;
  gap: 12rpx;
  padding: 0 28rpx;
}

.filter-pill {
  min-width: 94rpx;
  padding: 13rpx 19rpx;
  border: 1rpx solid #dfe5e2;
  border-radius: 10rpx;
  color: #5d6a66;
  background: #ffffff;
  font-size: 23rpx;
  line-height: 1.3;
  text-align: center;
}

.filter-active {
  border-color: #176f68;
  color: #ffffff;
  background: #176f68;
}

.list-heading {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 17rpx;
}

.list-title {
  color: #23302d;
  font-size: 30rpx;
  font-weight: 700;
}

.list-count {
  color: #87918e;
  font-size: 22rpx;
}

.order-list {
  display: flex;
  flex-direction: column;
  gap: 15rpx;
}

.order-card {
  padding: 23rpx 22rpx 19rpx;
  border: 1rpx solid #e5eae8;
  border-radius: 14rpx;
  background: #ffffff;
  box-shadow: 0 3rpx 12rpx rgba(28, 52, 45, 0.035);
}

.card-topline,
.guest-row,
.card-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.hotel-name {
  overflow: hidden;
  max-width: 75%;
  color: #202c29;
  font-size: 29rpx;
  font-weight: 700;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.status {
  flex: none;
  padding: 6rpx 12rpx;
  border-radius: 8rpx;
  font-size: 20rpx;
}

.status-wait {
  color: #a15b20;
  background: #fff0df;
}

.status-live {
  color: #167367;
  background: #e3f3ee;
}

.status-done {
  color: #576c8a;
  background: #eaf0f7;
}

.order-subtitle {
  margin-top: 8rpx;
  color: #73817c;
  font-size: 22rpx;
}

.meta-line {
  display: flex;
  flex-wrap: wrap;
  gap: 7rpx 14rpx;
  margin-top: 8rpx;
  color: #89938f;
  font-size: 20rpx;
}

.guest-row {
  justify-content: flex-start;
  gap: 13rpx;
  margin-top: 20rpx;
}

.guest-name {
  color: #283632;
  font-size: 26rpx;
  font-weight: 600;
}

.phone-link {
  padding: 4rpx 11rpx;
  border-radius: 7rpx;
  color: #176f68;
  background: #edf6f3;
  font-size: 20rpx;
  line-height: 1.4;
}

.detail-grid {
  display: grid;
  grid-template-columns: 1.35fr 1fr;
  gap: 13rpx 10rpx;
  margin-top: 19rpx;
  color: #34423d;
  font-size: 22rpx;
}

.detail-item {
  display: flex;
  min-width: 0;
  align-items: baseline;
  gap: 9rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.detail-key {
  flex: none;
  color: #89938f;
}

.card-footer {
  margin-top: 20rpx;
  padding-top: 15rpx;
  border-top: 1rpx solid #edf0ef;
}

.payment-note {
  color: #7c8985;
  font-size: 21rpx;
}

.received-value {
  margin-left: 4rpx;
  color: #176f68;
  font-weight: 700;
}

.total-value {
  color: #8b9692;
}

.edit-label {
  color: #6f7c78;
  font-size: 21rpx;
}

.chevron {
  margin-left: 4rpx;
  color: #84918d;
  font-size: 29rpx;
}

.empty-state {
  display: flex;
  min-height: 350rpx;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border: 1rpx dashed #d4ddda;
  border-radius: 14rpx;
  background: rgba(255, 255, 255, 0.7);
}

.empty-symbol {
  display: flex;
  width: 74rpx;
  height: 74rpx;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  color: #176f68;
  background: #e4f1ed;
  font-size: 43rpx;
}

.empty-title {
  margin-top: 18rpx;
  color: #33423d;
  font-size: 27rpx;
  font-weight: 600;
}

.empty-caption {
  margin-top: 9rpx;
  color: #89938f;
  font-size: 22rpx;
}

.storage-note {
  padding: 26rpx 0 10rpx;
  color: #8c9692;
  font-size: 20rpx;
  text-align: center;
}

.bottom-bar {
  position: fixed;
  z-index: 3;
  right: 0;
  bottom: 0;
  left: 0;
  padding: 17rpx 28rpx calc(17rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid #e5eae8;
  background: rgba(255, 255, 255, 0.97);
}

.add-button {
  display: flex;
  width: 100%;
  height: 88rpx;
  align-items: center;
  justify-content: center;
  border-radius: 12rpx;
  color: #ffffff;
  background: #176f68;
  font-size: 29rpx;
  font-weight: 600;
  line-height: 88rpx;
}

.add-mark {
  margin-right: 11rpx;
  font-size: 36rpx;
  font-weight: 400;
}
