.page { min-height: 100vh; color: #17233c; background: #f4f6fa; }
.form-scroll { height: calc(100vh - 145rpx - env(safe-area-inset-bottom)); }
.form-content { padding: 0 38rpx 35rpx; }
.form-intro { margin: 35rpx 4rpx; color: #59667d; font-size: 25rpx; }
.section { margin-bottom: 38rpx; }
.section-title { display: flex; align-items: center; gap: 12rpx; margin-bottom: 13rpx; padding: 0 22rpx; color: #59667d; font-size: 25rpx; font-weight: 550; }
.optional { color: #59667d; font-size: 21rpx; font-weight: 400; }
.field-group { padding: 0 28rpx; border-radius: 24rpx; background: #fff; }
.field-row { display: flex; min-width: 0; min-height: 112rpx; align-items: center; gap: 19rpx; border-bottom: 1rpx solid #e5eaf2; }
.field-row:last-child { border-bottom: 0; }
.field-label { width: 157rpx; flex: none; color: #35435b; font-size: 27rpx; }
.required { color: #1260de; font-size: 23rpx; }
.field-input { min-width: 0; width: 0; height: 84rpx; flex: 1; color: #17233c; font-size: 31rpx; text-align: left; }
.field-input::placeholder, .fee-input::placeholder { color: #59667d; }
.field-stacked { align-items: stretch; flex-direction: column; gap: 3rpx; padding: 23rpx 0 15rpx; }
.field-stacked .field-label { width: auto; }
.field-stacked .field-input { width: 100%; min-height: 72rpx; flex: none; }
.date-picker { min-width: 0; flex: 1; }
.picker-value { display: flex; height: 84rpx; align-items: center; justify-content: space-between; gap: 10rpx; font-size: 31rpx; }
.small-icon { width: 27rpx; height: 27rpx; flex: none; }
.stepper { display: flex; min-width: 0; align-items: center; gap: 3rpx; margin-left: auto; }
.stepper button { display: flex; width: 75rpx; min-height: 84rpx; align-items: center; justify-content: center; padding: 0; border-radius: 14rpx; color: #1260de; background: #f0f5ff; font-size: 36rpx; line-height: 1; }
.stepper .numeric-input { width: 50rpx; flex: none; text-align: center; }
.unit { margin-right: 6rpx; color: #59667d; font-size: 24rpx; }
.segmented { display: flex; gap: 5rpx; margin-left: auto; padding: 5rpx; border-radius: 13rpx; background: #edf1f7; }
.segment { min-width: 100rpx; padding: 14rpx 14rpx; border-radius: 10rpx; color: #59667d; font-size: 24rpx; text-align: center; }
.segment-active { color: #1260de; background: #fff; font-weight: 600; }
.fee-group { padding-top: 24rpx; padding-bottom: 20rpx; }
.fee-input { display: block; width: 100%; min-height: 190rpx; padding: 0; color: #17233c; font-size: 31rpx; line-height: 1.7; }
.textarea-footer { display: flex; justify-content: space-between; gap: 15rpx; margin-top: 14rpx; color: #59667d; font-size: 21rpx; }
.delete-button { width: 100%; min-height: 100rpx; border-radius: 23rpx; color: #bd3142; background: #fff; font-size: 27rpx; }
.form-actions { position: fixed; z-index: 10; right: 0; bottom: 0; left: 0; padding: 23rpx 38rpx calc(23rpx + env(safe-area-inset-bottom)); border-top: 1rpx solid #e5eaf2; background: #fff; }
.save-button { display: flex; width: 100%; height: 100rpx; align-items: center; justify-content: center; gap: 15rpx; padding: 0; border-radius: 23rpx; color: #fff; background: #1260de; font-size: 31rpx; font-weight: 600; line-height: 1; }
.save-button .icon { width: 38rpx; height: 38rpx; }

.stepper button { min-width: 44px; min-height: 44px; }
.segment { min-height: 44px; display: flex; align-items: center; justify-content: center; }
