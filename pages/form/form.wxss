.page {
  min-height: 100vh;
  color: #1e3438;
  background: #f2f5f5;
}

.form-scroll {
  height: calc(100vh - 126rpx - env(safe-area-inset-bottom));
}

.form-intro {
  padding: 30rpx 30rpx 24rpx;
}

.form-kicker {
  color: #c95745;
  font-size: 18rpx;
  font-weight: 700;
}

.form-title {
  margin-top: 8rpx;
  color: #1e3438;
  font-size: 39rpx;
  font-weight: 700;
}

.section {
  margin: 0 22rpx 17rpx;
  padding: 0 20rpx 18rpx;
  border: 1rpx solid #e0e8e8;
  border-radius: 18rpx;
  background: #ffffff;
  box-shadow: 0 5rpx 15rpx rgba(26,54,57,.035);
}

.section-heading {
  display: flex;
  height: 82rpx;
  align-items: center;
  gap: 12rpx;
  border-bottom: 1rpx solid #edf1f1;
}

.section-mark {
  display: flex;
  width: 42rpx;
  height: 42rpx;
  align-items: center;
  justify-content: center;
  border-radius: 12rpx;
  font-size: 19rpx;
  font-weight: 700;
}

.section-mark-coral {
  color: #c95745;
  background: #fff0eb;
}

.section-mark-blue {
  color: #4b7897;
  background: #edf4f8;
}

.section-mark-gold {
  color: #a9772d;
  background: #fbf3e5;
}

.section-title {
  color: #1e3438;
  font-size: 26rpx;
  font-weight: 700;
}

.field-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 13rpx 12rpx;
  padding-top: 16rpx;
}

.field-row {
  display: flex;
  min-width: 0;
  min-height: 118rpx;
  flex-direction: column;
  justify-content: center;
  gap: 8rpx;
  padding: 12rpx 13rpx;
  border: 1rpx solid #e0e8e8;
  border-radius: 13rpx;
  background: #f8fafa;
}

.field-wide {
  grid-column: 1 / -1;
}

.field-label {
  color: #58696b;
  font-size: 21rpx;
}

.required {
  color: #c95745;
}

.field-input {
  width: 100%;
  min-width: 0;
  height: 46rpx;
  color: #1e3438;
  font-size: 23rpx;
  line-height: 46rpx;
}

.field-input::placeholder,
.fee-input::placeholder {
  color: #9aa7a8;
}

.picker-value {
  display: flex;
  min-width: 0;
  height: 46rpx;
  align-items: center;
  color: #1e3438;
  font-size: 22rpx;
}

.picker-value::after {
  display: inline-block;
  width: 10rpx;
  height: 10rpx;
  margin: 0 3rpx 3rpx 10rpx;
  border-top: 2rpx solid #718284;
  border-right: 2rpx solid #718284;
  content: "";
  transform: rotate(45deg);
}

.number-entry {
  display: flex;
  min-width: 0;
  align-items: center;
  gap: 8rpx;
}

.numeric-input {
  flex: 1;
}

.unit {
  flex: none;
  color: #748487;
  font-size: 21rpx;
}

.field-meal {
  min-height: 116rpx;
}

.segmented {
  display: flex;
  width: 100%;
  gap: 7rpx;
  padding: 5rpx;
  border-radius: 12rpx;
  background: #eaf0ef;
}

.segment {
  flex: 1;
  min-width: 0;
  padding: 11rpx 8rpx;
  border-radius: 9rpx;
  color: #748487;
  font-size: 20rpx;
  text-align: center;
}

.segment-active {
  color: #286f68;
  background: #ffffff;
  box-shadow: 0 3rpx 8rpx rgba(31,54,47,.1);
  font-weight: 650;
}

.fee-section {
  padding-bottom: 18rpx;
}

.fee-input {
  display: block;
  width: 100%;
  min-height: 140rpx;
  margin-top: 16rpx;
  padding: 15rpx;
  border: 1rpx solid #e0e8e8;
  border-radius: 13rpx;
  color: #1e3438;
  background: #f8fafa;
  font-size: 22rpx;
  line-height: 1.5;
}

.form-bottom-space {
  height: 20rpx;
}

.form-actions {
  position: fixed;
  z-index: 3;
  right: 0;
  bottom: 0;
  left: 0;
  display: flex;
  gap: 12rpx;
  padding: 15rpx 22rpx calc(15rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid #e2e9e8;
  background: rgba(255,255,255,.97);
}

.save-button,
.delete-button {
  height: 88rpx;
  margin: 0;
  border-radius: 16rpx;
  font-size: 26rpx;
  font-weight: 700;
  line-height: 88rpx;
}

.save-button {
  flex: 1;
  color: #ffffff;
  background: #173b3d;
}

.delete-button {
  width: 160rpx;
  color: #bd5147;
  background: #fff0ee;
}

.save-button::after,
.delete-button::after {
  border: 0;
}
