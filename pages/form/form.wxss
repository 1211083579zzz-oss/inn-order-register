.page {
  min-height: 100vh;
}

.form-scroll {
  height: calc(100vh - 132rpx - env(safe-area-inset-bottom));
}

.form-intro {
  padding: 30rpx 30rpx 21rpx;
}

.form-title {
  color: #22302c;
  font-size: 34rpx;
  font-weight: 700;
}

.form-subtitle {
  margin-top: 7rpx;
  color: #7e8985;
  font-size: 22rpx;
}

.section {
  margin: 0 24rpx 18rpx;
  padding: 0 22rpx;
  border: 1rpx solid #e3e9e6;
  border-radius: 14rpx;
  background: #ffffff;
}

.section-heading {
  display: flex;
  height: 84rpx;
  align-items: center;
  gap: 13rpx;
  border-bottom: 1rpx solid #edf0ef;
}

.section-number {
  color: #176f68;
  font-size: 22rpx;
  font-weight: 700;
}

.section-blue {
  color: #3b6fa8;
}

.section-orange {
  color: #bb722e;
}

.section-title {
  color: #283632;
  font-size: 26rpx;
  font-weight: 700;
}

.field-row {
  display: flex;
  min-height: 86rpx;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  border-bottom: 1rpx solid #f0f2f1;
}

.field-last {
  border-bottom: 0;
}

.field-label {
  flex: none;
  color: #46534f;
  font-size: 24rpx;
}

.required {
  color: #c6534b;
}

.field-input {
  width: 60%;
  min-height: 70rpx;
  color: #22302c;
  font-size: 24rpx;
  text-align: right;
}

.field-input::placeholder,
.fee-input::placeholder {
  color: #a4ada9;
}

.picker-value {
  min-width: 220rpx;
  padding: 22rpx 0;
  color: #26342f;
  font-size: 24rpx;
  text-align: right;
}

.picker-value::after {
  display: inline-block;
  width: 12rpx;
  height: 12rpx;
  margin: 0 3rpx 3rpx 14rpx;
  border-top: 2rpx solid #899590;
  border-right: 2rpx solid #899590;
  content: "";
  transform: rotate(45deg);
}

.number-entry {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 9rpx;
}

.numeric-input {
  width: 150rpx;
}

.currency,
.unit {
  color: #56635f;
  font-size: 23rpx;
}

.guest-field-row {
  min-height: 96rpx;
}

.guest-inputs {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.guest-input-wrap {
  display: flex;
  align-items: center;
  gap: 8rpx;
  color: #75817d;
  font-size: 21rpx;
}

.guest-input {
  width: 76rpx;
  height: 54rpx;
  border: 1rpx solid #e1e7e4;
  border-radius: 8rpx;
  color: #26342f;
  background: #f8faf9;
  font-size: 23rpx;
  text-align: center;
}

.segmented {
  display: flex;
  padding: 5rpx;
  border-radius: 9rpx;
  background: #f0f3f1;
}

.segment {
  min-width: 112rpx;
  padding: 11rpx 13rpx;
  border-radius: 7rpx;
  color: #74807b;
  font-size: 21rpx;
  text-align: center;
}

.segment-active {
  color: #176f68;
  background: #ffffff;
  box-shadow: 0 2rpx 5rpx rgba(20, 55, 45, 0.1);
}

.field-stack {
  display: block;
  padding: 19rpx 0;
}

.fee-input {
  display: block;
  width: 100%;
  min-height: 86rpx;
  margin-top: 13rpx;
  padding: 15rpx;
  border: 1rpx solid #e5eae8;
  border-radius: 8rpx;
  color: #283632;
  background: #fafcfb;
  font-size: 23rpx;
  line-height: 1.5;
}

.form-bottom-space {
  height: 18rpx;
}

.form-actions {
  position: fixed;
  z-index: 3;
  right: 0;
  bottom: 0;
  left: 0;
  display: flex;
  gap: 14rpx;
  padding: 17rpx 24rpx calc(17rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid #e4e9e7;
  background: rgba(255, 255, 255, 0.98);
}

.save-button,
.delete-button {
  height: 88rpx;
  border-radius: 12rpx;
  font-size: 27rpx;
  font-weight: 600;
  line-height: 88rpx;
}

.save-button {
  flex: 1;
  color: #ffffff;
  background: #176f68;
}

.save-editing {
  flex: 1;
}

.delete-button {
  width: 172rpx;
  color: #b54842;
  background: #f8eceb;
}
