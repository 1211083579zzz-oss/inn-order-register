.page {
  min-height: 100vh;
  background: #f4f5f2;
}

.form-scroll {
  height: calc(100vh - 124rpx - env(safe-area-inset-bottom));
}

.form-intro {
  padding: 28rpx 30rpx 22rpx;
}

.form-kicker {
  color: #9b6941;
  font-size: 18rpx;
  font-weight: 700;
}

.form-title {
  margin-top: 8rpx;
  color: #202b29;
  font-size: 37rpx;
  font-weight: 700;
}

.section {
  margin: 0 22rpx 16rpx;
  padding: 0 20rpx;
  border: 1rpx solid #e4e9e6;
  border-radius: 13rpx;
  background: #ffffff;
}

.section-heading {
  display: flex;
  height: 76rpx;
  align-items: center;
  gap: 12rpx;
  border-bottom: 1rpx solid #edf0ee;
}

.section-mark {
  color: #176f68;
  font-size: 20rpx;
  font-weight: 700;
}

.section-mark-blue {
  color: #47739a;
}

.section-mark-orange {
  color: #a86631;
}

.section-title {
  color: #2a3733;
  font-size: 25rpx;
  font-weight: 650;
}

.field-row {
  display: flex;
  min-height: 84rpx;
  align-items: center;
  justify-content: space-between;
  gap: 14rpx;
  border-bottom: 1rpx solid #f0f2f1;
}

.field-last {
  border-bottom: 0;
}

.field-label {
  flex: none;
  color: #495752;
  font-size: 23rpx;
}

.required {
  color: #bf5a4c;
}

.field-input {
  width: 62%;
  min-height: 68rpx;
  color: #25322f;
  font-size: 23rpx;
  text-align: right;
}

.field-input::placeholder,
.fee-input::placeholder {
  color: #a0aaa5;
}

.picker-value {
  min-width: 230rpx;
  padding: 20rpx 0;
  color: #25322f;
  font-size: 23rpx;
  text-align: right;
}

.picker-value::after {
  display: inline-block;
  width: 11rpx;
  height: 11rpx;
  margin: 0 3rpx 3rpx 12rpx;
  border-top: 2rpx solid #88938e;
  border-right: 2rpx solid #88938e;
  content: "";
  transform: rotate(45deg);
}

.number-entry {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 9rpx;
}

.numeric-input {
  width: 130rpx;
}

.unit {
  color: #66736e;
  font-size: 22rpx;
}

.segmented {
  display: flex;
  gap: 6rpx;
  padding: 5rpx;
  border-radius: 9rpx;
  background: #f0f3f1;
}

.segment {
  min-width: 112rpx;
  padding: 11rpx 12rpx;
  border-radius: 7rpx;
  color: #75817c;
  font-size: 20rpx;
  text-align: center;
}

.segment-active {
  color: #176f68;
  background: #ffffff;
  box-shadow: 0 2rpx 6rpx rgba(31, 54, 47, 0.1);
}

.fee-section {
  padding-bottom: 18rpx;
}

.fee-input {
  display: block;
  width: 100%;
  min-height: 122rpx;
  margin-top: 16rpx;
  padding: 15rpx;
  border: 1rpx solid #e5eae7;
  border-radius: 9rpx;
  color: #283632;
  background: #fafbf9;
  font-size: 22rpx;
  line-height: 1.5;
}

.form-bottom-space {
  height: 20rpx;
}

.form-actions {
  position: fixed;
  z-index: 3;
  right: 0;
  bottom: 0;
  left: 0;
  display: flex;
  gap: 12rpx;
  padding: 15rpx 22rpx calc(15rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid #e3e8e5;
  background: rgba(255, 255, 255, 0.98);
}

.save-button,
.delete-button {
  height: 84rpx;
  border-radius: 11rpx;
  font-size: 26rpx;
  font-weight: 600;
  line-height: 84rpx;
}

.save-button {
  flex: 1;
  color: #ffffff;
  background: #243c38;
}

.delete-button {
  width: 160rpx;
  color: #b54842;
  background: #f8eceb;
}
