page {
  min-height: 100%;
  background: #f4f6f5;
  color: #1d2928;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
  font-size: 28rpx;
}

button {
  box-sizing: border-box;
  margin: 0;
  border: 0;
  font-family: inherit;
}

button::after {
  border: 0;
}

input,
textarea {
  box-sizing: border-box;
  font-family: inherit;
}
